# ─────────────────────────────────────────────────────────────────────────────
# Bezoom – Environment Variables for Local Development
# Copy to .env.local and adjust values as needed.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
HEALTH_CHECK_TIMEOUT_MS=2000
# Number of trusted reverse-proxy hops in front of the API (0 for direct local traffic).
TRUST_PROXY_HOPS=0

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=bezoom
POSTGRES_PASSWORD=bezoom_dev
POSTGRES_PORT=5432
# PgBouncer is not used in local dev (connect directly to postgres:5432)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_dev
REDIS_PORT=6379

# ── File Storage (MinIO + Local) ──────────────────────────────────────────────
# In development (NODE_ENV=development): files stored in ./uploads directory
# In production (NODE_ENV=production): files stored in MinIO S3-compatible storage
LOCAL_STORAGE_PATH=./uploads

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# App-side client config (defaults below match the root user/pass + API port above)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_USE_SSL=false
MINIO_RAW_BUCKET=raw-uploads
MINIO_MEDIA_BUCKET=media
# Public host embedded in presigned upload URLs. Use your LAN IP for a physical phone.
MINIO_PRESIGN_ENDPOINT=localhost
MINIO_PRESIGN_PORT=9000
MINIO_PRESIGN_USE_SSL=false
# MINIO_PUBLIC_URL=https://media.bezoom.pl

# Local-only event pipeline. Production defaults to disabled until real
# moderation plus decode/re-encode workers are configured.
EVENT_PIPELINE_MODE=development_passthrough
EVENT_PIPELINE_DISPATCH_INTERVAL_MS=500

# ── Keycloak ──────────────────────────────────────────────────────────────
# Keycloak admin credentials (development only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=password
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bezoom
KEYCLOAK_CLIENT_ID=bezoom-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SWAGGER_CLIENT_ID=bezoom-web

# HMAC secret used to protect short-lived phone verification codes.
# Use a separate, random secret in every non-local environment.
PHONE_VERIFICATION_HASH_SECRET=replace-with-a-random-local-secret

# ── Mailpit ───────────────────────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── Redis Commander (queue/key browser) ──────────────────────────────────────
REDIS_COMMANDER_PORT=3010

# ── Next.js Web ───────────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── HuggingFace (for moderation services) ────────────────────────────────────
# HF_TOKEN=hf_your_token_here

# ── Maps (profile: maps) ─────────────────────────────────────────────────────
# Override to use a smaller/different region:
# NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/poland-latest.osm.pbf
NOMINATIM_DB_PASSWORD=nominatim_dev
NOMINATIM_PORT=8080
OSRM_PORT=5000

# ── pgAdmin (profile: tools) ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@bezoom.local
PGADMIN_PASSWORD=pgadmin_dev
PGADMIN_PORT=5050

# ── Redis Insight (profile: tools) ───────────────────────────────────────────
REDIS_INSIGHT_PORT=8001

# ── Observability (profile: observability) ────────────────────────────────────
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
