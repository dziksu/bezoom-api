# ─────────────────────────────────────────────────────────────────────────────
# Bezoom – Environment Variables for Local Development
# Copy to .env.local and adjust values as needed.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
HEALTH_CHECK_TIMEOUT_MS=2000
# all = API and workers in one process (local default); production should use
# separate api and worker deployments.
PROCESS_ROLE=all
EVENT_OUTBOX_RETENTION_DAYS=7
# Number of trusted reverse-proxy hops in front of the API (0 for direct local traffic).
TRUST_PROXY_HOPS=0
EVENT_MAP_RATE_LIMIT_PER_MINUTE=3000
EVENT_SEARCH_RATE_LIMIT_PER_MINUTE=6000
# Log every successful request locally. Production default is 0.01 (1%);
# errors and responses slower than 500 ms are always logged.
HTTP_SUCCESS_LOG_SAMPLE_RATE=1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=bezoom
POSTGRES_PASSWORD=bezoom_dev
POSTGRES_PORT=5432
# PgBouncer is not used in local dev (connect directly to postgres:5432)
DATABASE_READ_MAX_CONNECTIONS=10
DATABASE_WRITE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5500

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_dev
REDIS_PORT=6379
# Production: point queue at a durable noeviction/AOF instance and cache at
# an independently memory-limited eviction-enabled instance.
# REDIS_QUEUE_URL=rediss://user:password@queue-redis:6379
# REDIS_CACHE_URL=rediss://user:password@cache-redis:6379
# REDIS_RATE_LIMIT_URL=rediss://user:password@rate-redis:6379

# ── Object Storage (MinIO locally, R2-compatible in production) ───────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# App-side client config (defaults below match the root user/pass + API port above)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_USE_SSL=false
MINIO_RAW_BUCKET=raw-uploads
MINIO_MEDIA_BUCKET=media
MINIO_AVATAR_BUCKET=avatars
# Public host embedded in presigned upload URLs. Use your LAN IP for a physical phone.
MINIO_PRESIGN_ENDPOINT=localhost
MINIO_PRESIGN_PORT=9000
MINIO_PRESIGN_USE_SSL=false
# MINIO_PUBLIC_URL=https://media.bezoom.pl

# Local-only event pipeline. Production defaults to disabled until real
# moderation plus decode/re-encode workers are configured.
EVENT_PIPELINE_MODE=development_passthrough
EVENT_PIPELINE_DISPATCH_INTERVAL_MS=500

# ── Keycloak ──────────────────────────────────────────────────────────────
# Keycloak admin credentials (development only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=password
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bezoom
KEYCLOAK_CLIENT_ID=bezoom-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SWAGGER_CLIENT_ID=bezoom-web
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ACCOUNT_MANAGEMENT_CLIENT_ID=bezoom-account-lifecycle
KEYCLOAK_ACCOUNT_MANAGEMENT_CLIENT_SECRET=dev-bezoom-account-lifecycle-secret
KEYCLOAK_ACCOUNT_CONSOLE_CLIENT_ID=bezoom-web
KEYCLOAK_ACCOUNT_RETURN_URL=http://localhost:3000/account
# Opcjonalne logowanie przez Google. Utwórz klienta OAuth typu Web application
# z redirect URI: http://localhost:8080/realms/bezoom/broker/google/endpoint
KEYCLOAK_GOOGLE_CLIENT_ID=
KEYCLOAK_GOOGLE_CLIENT_SECRET=
ACCOUNT_DELETION_GRACE_DAYS=30
ACCOUNT_DELETION_WORKER_INTERVAL_MS=30000
ACCOUNT_DELETION_STATEMENT_TIMEOUT_MS=30000

# HMAC secret used to protect short-lived phone verification codes.
# Use a separate, random secret in every non-local environment.
PHONE_VERIFICATION_HASH_SECRET=replace-with-a-random-local-secret

# ── Mailpit ───────────────────────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Development-only SMS simulation: OTP is sent as an email captured by Mailpit.
PHONE_VERIFICATION_DELIVERY_MODE=development_email
DEV_SMS_SMTP_HOST=localhost
DEV_SMS_SMTP_PORT=1025
DEV_SMS_FROM_EMAIL=sms@bezoom.local

# ── Redis Commander (queue/key browser) ──────────────────────────────────────
REDIS_COMMANDER_PORT=3010

# ── Next.js Web ───────────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── HuggingFace (for moderation services) ────────────────────────────────────
# HF_TOKEN=hf_your_token_here

# ── Maps (profile: maps) ─────────────────────────────────────────────────────
# Override to use a smaller/different region:
# NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/poland-latest.osm.pbf
NOMINATIM_DB_PASSWORD=nominatim_dev
NOMINATIM_PORT=8092
OSRM_PORT=5000

# ── pgAdmin (profile: tools) ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@bezoom.local
PGADMIN_PASSWORD=pgadmin_dev
PGADMIN_PORT=5050

# ── Redis Insight (profile: tools) ───────────────────────────────────────────
REDIS_INSIGHT_PORT=8001

# ── Observability (profile: observability) ────────────────────────────────────
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
