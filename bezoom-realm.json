{
  "realm": "bezoom",
  "enabled": true,
  "displayName": "Bezoom (Dev)",
  "displayNameHtml": "<b>Bezoom Dev</b>",

  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,

  "sslRequired": "none",
  "internationalizationEnabled": false,

  "accessTokenLifespan": 1800,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 43200,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 5184000,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,

  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "defaultSignatureAlgorithm": "RS256",
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@bezoom.local",
    "fromDisplayName": "Bezoom Dev",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "requiredActions": [
    {
      "alias": "UPDATE_EMAIL",
      "name": "Update Email",
      "providerId": "UPDATE_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 70
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": false,
      "defaultAction": false,
      "priority": 80
    }
  ],

  "roles": {
    "realm": [
      { "name": "user", "description": "Default role for all authenticated users" },
      { "name": "admin", "description": "Full administrative access across the platform" }
    ],
    "client": {
      "bezoom-api": [
        { "name": "read:orders", "description": "Can read order data" },
        { "name": "write:orders", "description": "Can create/modify order data" },
        { "name": "read:users", "description": "Can read user profile data" },
        { "name": "manage:users", "description": "Can manage other users (admin-level API access)" }
      ]
    }
  },

  "defaultRole": {
    "name": "default-roles-bezoom",
    "description": "Default composite role granted to every new user",
    "composite": true,
    "clientRole": false,
    "composites": {
      "realm": ["user"]
    }
  },

  "clients": [
    {
      "clientId": "bezoom-web",
      "name": "Bezoom Next.js Frontend",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-bezoom-web-secret",

      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,

      "redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],

      "webOrigins": ["http://localhost:3000"],

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },

      "defaultClientScopes": ["basic", "profile", "email", "roles"],

      "protocolMappers": [
        {
          "name": "bezoom-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bezoom-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ],

      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "bezoom-api",
      "name": "Bezoom API",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-bezoom-api-secret",

      "serviceAccountsEnabled": false,

      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,

      "defaultClientScopes": ["roles"],

      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "bezoom-account-lifecycle",
      "name": "Bezoom Account Lifecycle Worker",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-bezoom-account-lifecycle-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "defaultClientScopes": ["roles"]
    }
  ],

  "users": [
    {
      "username": "service-account-bezoom-account-lifecycle",
      "enabled": true,
      "serviceAccountClientId": "bezoom-account-lifecycle",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    },
    {
      "username": "admin@bezoom.com",
      "email": "admin@bezoom.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bezoom",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "Test1234!", "temporary": false }],
      "realmRoles": ["user", "admin"],
      "clientRoles": {
        "bezoom-api": ["read:orders", "write:orders", "read:users", "manage:users"]
      }
    },
    {
      "username": "user@bezoom.com",
      "email": "user@bezoom.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "Test1234!", "temporary": false }],
      "realmRoles": ["user"],
      "clientRoles": {
        "bezoom-api": ["read:orders"]
      }
    }
  ]
}
