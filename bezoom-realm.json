{
  "realm": "bezoom",
  "enabled": true,
  "displayName": "Bezoom (Dev)",
  "displayNameHtml": "<b>Bezoom Dev</b>",

  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,

  "sslRequired": "none",
  "internationalizationEnabled": false,

  "accessTokenLifespan": 1800,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 43200,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 5184000,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,

  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "defaultSignatureAlgorithm": "RS256",

  "roles": {
    "realm": [
      { "name": "user", "description": "Default role for all authenticated users" },
      { "name": "admin", "description": "Full administrative access across the platform" }
    ],
    "client": {
      "bezoom-api": [
        { "name": "read:orders", "description": "Can read order data" },
        { "name": "write:orders", "description": "Can create/modify order data" },
        { "name": "read:users", "description": "Can read user profile data" },
        { "name": "manage:users", "description": "Can manage other users (admin-level API access)" }
      ]
    }
  },

  "defaultRole": {
    "name": "default-roles-bezoom",
    "description": "Default composite role granted to every new user",
    "composite": true,
    "clientRole": false,
    "composites": {
      "realm": ["user"]
    }
  },

  "clients": [
    {
      "clientId": "bezoom-web",
      "name": "Bezoom Next.js Frontend",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-bezoom-web-secret",

      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,

      "redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],

      "webOrigins": ["http://localhost:3000"],

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },

      "defaultClientScopes": ["profile", "email", "roles"],

      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "bezoom-api",
      "name": "Bezoom API",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-bezoom-api-secret",

      "serviceAccountsEnabled": true,

      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,

      "defaultClientScopes": ["roles"],

      "optionalClientScopes": ["offline_access"]
    }
  ],

  "users": [
    {
      "username": "admin@bezoom.com",
      "email": "admin@bezoom.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bezoom",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "Test1234!", "temporary": false }],
      "realmRoles": ["user", "admin"],
      "clientRoles": {
        "bezoom-api": ["read:orders", "write:orders", "read:users", "manage:users"]
      }
    },
    {
      "username": "user@bezoom.com",
      "email": "user@bezoom.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "Test1234!", "temporary": false }],
      "realmRoles": ["user"],
      "clientRoles": {
        "bezoom-api": ["read:orders"]
      }
    }
  ]
}
